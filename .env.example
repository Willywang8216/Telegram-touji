# Copy this file to .env and fill in locally.
# Do NOT commit real secrets.

API_ID=26141001
API_HASH=
MASTER_ACCOUNT_ID=5505419525

# Relay bot credentials (can be the same API_ID/API_HASH)
RELAY_API_ID=26141001
RELAY_API_HASH=
RELAY_BOT_TOKEN=

# Optional: override relay destination chat ids (comma-separated, e.g. -100123,-100456)
# If set, it overrides relay.dest_channels in config.json
RELAY_DEST_CHANNELS=

# Security: whitelist who can DM the relay bot (comma-separated Telegram user IDs)
# If set, it overrides relay.allowed_sender_ids.
RELAY_ALLOWED_SENDER_IDS=
