{
  "api_id": 12345678,
  "api_hash": "your_api_hash",
  "master_account_id": 123456789,
  "bot_mappings": [
    {
      "source_chat": -1001234567890,
      "target_bot": "@your_middle_bot"
    }
  ],
  "relay": {
    "api_id": 12345678,
    "api_hash": "your_api_hash",
    "bot_token": "123456:ABCDEF_your_bot_token",

    "strip_text": true,

    "dest_channels": [-1009876543210],
    "default_destinations": [
      {"chat_id": -1009876543210, "bucket_topics": {"prefix": "Bucket ", "count": 5, "by": "message"}}
    ],

    "forum_topic_top_messages": {
      "-1009876543210": {
        "General": 123
      }
    },

    "routes": [
      {
        "source_chat": -1001234567890,
        "destinations": [
          {"chat_id": -1009876543210, "topic_title": "General"}
        ]
      }
    ],

    "ensure_forum_topics": [
      {"chat_id": -1009876543210, "topics": ["English", "中文"]}
    ],

    "topic_renames": {
      "-1009876543210": {
        "Mandarin Chinese speaker": "中文（繁體）"
      }
    },

    "blocklist_substrings": [
      "全球最快VPN",
      "网黄尊享"
    ],

    "blocklist_regexes": [
      "\\b(?:usdt|btc|eth)\\b"
    ],
    "block_contact_ads": true,
    "fallback_to_general_topic": false
  },
  "proxy": null
}
