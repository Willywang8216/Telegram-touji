{
  "api_id": 12345678,
  "api_hash": "your_api_hash",
  "master_account_id": 123456789,
  "bot_mappings": [
    {
      "source_chat": -1001234567890,
      "target_bot": "@your_middle_bot"
    }
  ],
  "relay": {
    "api_id": 12345678,
    "api_hash": "your_api_hash",
    "bot_token": "123456:ABCDEF_your_bot_token",
    "dest_channels": [-1009876543210],
    "master_account_id": 0,

    "post_captions": {
      "-1009876543210": "Powered by relaybot"
    },

    "expand_twitter_links": true,
    "twitter_cookies_file": null,
    "twitter_max_media_files": 8,

    "routes": [
      {
        "source_chats": [-1001234567890],
        "destinations": [{"chat_id": -1009876543210, "topic_title": "Topic A"}]
      },
      {
        "source_chats": [-1001234567890],
        "source_topics": [777],
        "destinations": [{"chat_id": -1009876543210, "topic_title": "Topic B"}]
      }
    ],

    "default_destinations": [{"chat_id": -1009876543210, "topic_title": "Default"}],

    "require_forum_topic": false,

    "topic_title_aliases": {
      "-1009876543210": {
        "Topic A": "Existing Topic A"
      }
    },

    "forum_topic_ids": {
      "-1009876543210": {
        "Topic A": 123456,
        "Default": 234567
      }
    },

    "manage_forum_topics": true,
    "allow_topic_creation": true,

    "distribute_unrouted_to_buckets": false,
    "unrouted_distribution_mode": "source",
    "general_topic_buckets": {
      "-1009876543210": ["Bucket 1", "Bucket 2", "Bucket 3", "Bucket 4", "Bucket 5"]
    },

    "blocklist_substrings": [
      "正品",
      "正版",
      "高仿",
      "水果",
      "手機",
      "emby"
    ],

    "ignore_source_chats": []
  },
  "proxy": null
}
